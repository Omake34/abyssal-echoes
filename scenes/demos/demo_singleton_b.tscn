[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/demos/demo_singleton_b.gd" id="1_singb"]

[node name="DemoSingletonB" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_singb")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -60.0
offset_right = 150.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "SCENE B (Output)"
horizontal_alignment = 1

[node name="Info" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "The score was preserved!"
horizontal_alignment = 1

[node name="ScoreLabel" type="Label" parent="VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Score: 0"
horizontal_alignment = 1

[node name="SwitchButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "<-- Back to Scene A"

[connection signal="pressed" from="VBoxContainer/SwitchButton" to="." method="_on_switch_button_pressed"]
