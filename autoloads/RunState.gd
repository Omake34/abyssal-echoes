# PURPOSE: RunState — Holds ALL data about the current run in progress.
# When a new run starts, this is reset. When a run ends, results feed into meta-progression.
# This is the "save file" for the current run.
# HOW TO USE:
#   RunState.gold += 50          # Give player gold
#   RunState.party[0]            # Get first hero in party
#   RunState.start_new_run()     # Reset everything for a new run

extends Node

# ── CONSTANTS ─────────────────────────────────────────────────────────────────

const MAX_PARTY_SIZE      = 4
const MAX_INVENTORY_SLOTS = 12
const MAX_SKILLS_PER_HERO = 3
const SAVE_PATH           = "user://run_state.json"

# ── RUN STATE VARIABLES ───────────────────────────────────────────────────────

## The player's current party — array of HeroInstance dictionaries
## Each hero instance: { "data": HeroData, "current_hp": int, "skills": Array, "position": Vector2i }
var party: Array = []

## Whether debug/cheat mode is active
var debug_mode: bool = false

## Player's current gold for this run
var gold: int = 0

## Items currently in the inventory (array of ItemData resources)
var inventory: Array = []

## Current node on the run map (0 = start)
var current_map_node: int = 0

## Which map nodes have been completed
var completed_nodes: Array = []

## Current run difficulty: "normal", "hard", "hell"
var difficulty: String = "normal"

# ── MAP STATE ─────────────────────────────────────────────────────────────────
## The procedural data generated by MapGenerator
var current_map: Array = []

## The ID of the node the player is currently at
var current_node_id: String = ""

## IDs of all nodes the player has finished
var completed_node_ids: Array[String] = []

## ID of a node where the battle is won but the reward is not yet claimed
var pending_reward_node_id: String = ""

## Resource paths keep the same reward choices when checking the team or loading a save.
var pending_reward_options: Array[String] = []
var pending_reward_gold: int = 0
var encounter_gold_start: int = 0

## Statistics for the end-of-run summary
var run_stats: Dictionary = {
	"battles_won": 0,
	"enemies_killed": 0,
	"skills_merged": 0,
	"gold_earned": 0,
	"turns_survived": 0,
}

## Whether a run is currently active
var run_active: bool = false

## Returns the dictionary data for the current map node
func get_current_node_data() -> Dictionary:
	for layer in current_map:
		for node in layer:
			if node["id"] == current_node_id:
				return node
	return {}

# ── META PROGRESSION (persists between runs) ──────────────────────────────────
# Loaded from a separate save file — not reset on new run

var meta: Dictionary = {
	"darkworld_coins": 0,        # Currency earned between runs
	"unlocked_heroes": ["warrior", "archer"],  # Start with 2 classes
	"unlocked_skills": [],       # EX skills unlocked after first crafting
	"discovered_skills": [],     # IDs of all skills ever seen
	"discovered_heroes": ["warrior", "archer"], # IDs of all heroes ever recruited
	"discovered_enemies": [],    # IDs of all enemies ever fought
	"talent_points_spent": {},   # Talent tree progress
	"total_runs": 0,
	"total_victories": 0,
}

## Adds a skill to the discovered list if not already there
func record_skill_discovery(skill_id: String) -> void:
	if not meta["discovered_skills"].has(skill_id):
		meta["discovered_skills"].append(skill_id)
		save_meta()

## Adds a hero to the discovered list if not already there
func record_hero_discovery(hero_id: String) -> void:
	if not meta["discovered_heroes"].has(hero_id):
		meta["discovered_heroes"].append(hero_id)
		save_meta()

## Adds an enemy to the discovered list if not already there
func record_enemy_discovery(enemy_id: String) -> void:
	if not meta["discovered_enemies"].has(enemy_id):
		meta["discovered_enemies"].append(enemy_id)
		save_meta()

## Unlocks a hero and saves meta progress
func unlock_hero(hero_id: String) -> void:
	if not meta["unlocked_heroes"].has(hero_id):
		meta["unlocked_heroes"].append(hero_id)
		save_meta()
		print("[RunState] Hero unlocked: " + hero_id)

const META_SAVE_PATH = "user://meta_progress.json"

# ── LIFECYCLE ─────────────────────────────────────────────────────────────────

func _ready() -> void:
	load_meta()

# ── RUN MANAGEMENT ────────────────────────────────────────────────────────────

## Call this to start a fresh run. Resets all run-specific data.
func start_new_run(chosen_difficulty: String = "normal") -> void:
	delete_save()
	party              = []
	gold               = 100  # Starting gold
	inventory          = []
	current_map_node   = 0
	completed_nodes    = []
	current_map        = []  # Will be regenerated by MapView
	current_node_id    = ""
	completed_node_ids = []
	clear_pending_reward()
	encounter_gold_start = 0
	difficulty         = chosen_difficulty
	run_active         = true
	
	# Apply "Bounty Hunter" Talent (Starting Gold)
	var bonus_gold = meta["talent_points_spent"].get("starting_gold", 0) * 20
	gold += bonus_gold
	
	run_stats = {
		"battles_won": 0,
		"enemies_killed": 0,
		"skills_merged": 0,
		"gold_earned": gold,
		"turns_survived": 0,
	}
	print("[RunState] New run started. Difficulty: " + difficulty)

# PURPOSE: Generate a node's reward once so navigation cannot reroll the choices.
func prepare_reward(node_id: String, gold_earned: int = 0) -> void:
	if node_id.is_empty():
		push_warning("[RunState] Cannot prepare rewards without a map node")
		return
	if pending_reward_node_id == node_id and not pending_reward_options.is_empty():
		return
	clear_pending_reward()
	pending_reward_node_id = node_id
	pending_reward_gold = maxi(0, gold_earned)
	var pool = GameData.get_skills_by_tier(1)
	pool.shuffle()
	for i in range(mini(3, pool.size())):
		pending_reward_options.append(pool[i].resource_path)
	save_run()

# PURPOSE: Claim only an offered skill; keep the reward available if inventory is full.
func claim_reward(skill: Resource = null) -> bool:
	if pending_reward_node_id.is_empty() or pending_reward_node_id != current_node_id:
		return false
	if skill != null:
		if not pending_reward_options.has(skill.resource_path):
			return false
		if not add_item(skill):
			return false
	if not completed_node_ids.has(current_node_id):
		completed_node_ids.append(current_node_id)
	clear_pending_reward()
	save_run()
	return true

# PURPOSE: Clear all reward details together when claiming or starting a new run.
func clear_pending_reward() -> void:
	pending_reward_node_id = ""
	pending_reward_options.clear()
	pending_reward_gold = 0

## Call this when the run ends (win or lose).
func end_run(victory: bool) -> void:
	run_active = false
	meta["total_runs"] += 1
	if victory:
		meta["total_victories"] += 1
		meta["darkworld_coins"] += _calculate_coin_reward()
	save_meta()
	delete_save()
	EventBus.run_ended.emit(victory, run_stats)

## Returns the coin reward based on run performance
func _calculate_coin_reward() -> int:
	var base = 10
	var difficulty_bonus = {"normal": 1, "hard": 2, "hell": 3}
	return base * difficulty_bonus.get(difficulty, 1)

# ── PARTY MANAGEMENT ──────────────────────────────────────────────────────────

## Adds a hero to the party. Returns false if party is full.
func add_hero_to_party(hero_data: Resource) -> bool:
	if party.size() >= MAX_PARTY_SIZE:
		push_warning("[RunState] Party is full — cannot add hero")
		return false
		
	# Calculate Meta Bonuses
	var hp_bonus = meta["talent_points_spent"].get("hp_boost", 0) * 10
	var atk_bonus = meta["talent_points_spent"].get("atk_boost", 0) * 2
	var speed_bonus = meta["talent_points_spent"].get("speed_boost", 0) * 1
	
	var hero_instance = {
		"data": hero_data,
		"max_hp_override": hero_data.base_hp + hp_bonus,
		"current_hp": hero_data.base_hp + hp_bonus,
		"atk_override": hero_data.base_atk + atk_bonus,
		"speed_override": hero_data.base_speed + speed_bonus,
		"skills": hero_data.starting_skills.duplicate(), 
		"slot_index": 0,
		"position": Vector2i(0, 0),
		"status_effects": [],
		"party_index": party.size()
	}
	party.append(hero_instance)
	record_hero_discovery(hero_data.hero_class)
	return true

## Heals all heroes by a percentage of their max HP (used at Rest nodes)
func heal_party(percent: float) -> void:
	for hero in party:
		var max_hp = hero.get("max_hp_override", hero["data"].base_hp)
		var heal_amount = int(max_hp * percent)
		hero["current_hp"] = min(hero["current_hp"] + heal_amount, max_hp)

# ── INVENTORY MANAGEMENT ──────────────────────────────────────────────────────

## Adds an item to inventory. Returns false if full.
func add_item(item: Resource) -> bool:
	if inventory.size() >= MAX_INVENTORY_SLOTS:
		push_warning("[RunState] Inventory full")
		return false
	inventory.append(item)
	record_skill_discovery(item.id)
	EventBus.item_acquired.emit(item)
	check_for_merges()
	return true

## Removes an item from inventory.
func remove_item(item: Resource) -> void:
	inventory.erase(item)
	EventBus.item_removed.emit(item)

## Salvages an item — removes it and gives 1 upgrade material (TODO: material system)
func salvage_item(item: Resource) -> void:
	remove_item(item)
	gold += 5  # Placeholder: salvage gives 5 gold for now
	EventBus.gold_changed.emit(gold)

## Automatically equips skills from inventory to suitable heroes
func auto_equip_skills() -> void:
	var items_to_remove = []
	
	for skill in inventory:
		var successfully_equipped = false
		
		# Try to find a suitable hero with an open slot
		for hero in party:
			var data = hero["data"]
			var current_skills = hero["skills"]
			
			# Check if hero has room
			if current_skills.size() >= data.skill_slots:
				continue
				
			# Check if skill is compatible with this class
			if skill.compatible_classes.is_empty() or data.hero_class in skill.compatible_classes:
				current_skills.append(skill)
				items_to_remove.append(skill)
				successfully_equipped = true
				break
	
	# Clean up inventory
	for item in items_to_remove:
		inventory.erase(item)
		EventBus.item_removed.emit(item)
	
	save_run()

func check_for_merges() -> void:
	var skill_counts = {}
	
	# Only check inventory for automatic merges (conservative behavior)
	for i in range(inventory.size()):
		var skill = inventory[i]
		if not skill.can_merge or skill.merge_result_id == "": continue
		var id = skill.id
		if not skill_counts.has(id):
			skill_counts[id] = []
		skill_counts[id].append({"type": "inventory", "skill": skill})
			
	for id in skill_counts:
		var locs = skill_counts[id]
		if locs.size() >= 3:
			var base_skill = locs[0]["skill"]
			var result_id = base_skill.merge_result_id
			
			for i in range(3):
				var loc = locs[i]
				inventory.erase(loc["skill"])
				EventBus.item_removed.emit(loc["skill"])
					
			# Try multiple path patterns to find the result skill
			var new_path = "res://resources/skills/skill_" + result_id + ".tres"
			if not FileAccess.file_exists(new_path):
				new_path = "res://resources/skills/" + result_id + ".tres"
				
			var new_skill = load(new_path)
			if new_skill:
				run_stats["skills_merged"] += 1
				EventBus.merge_completed.emit(new_skill)
				add_item(new_skill)
			else:
				push_error("[RunState] Merge failed: Could not load " + new_path)
			return

# ── GOLD MANAGEMENT ───────────────────────────────────────────────────────────

func add_gold(amount: int) -> void:
	gold += amount
	run_stats["gold_earned"] += amount
	EventBus.gold_changed.emit(gold)

func spend_gold(amount: int) -> bool:
	if gold < amount:
		push_warning("[RunState] Not enough gold")
		return false
	gold -= amount
	EventBus.gold_changed.emit(gold)
	return true

# ── SAVE / LOAD ───────────────────────────────────────────────────────────────

## Checks if there is a saved run to continue
func has_saved_run() -> bool:
	return FileAccess.file_exists(SAVE_PATH)

## Deletes the current run save (called when run ends or a new run starts)
func delete_save() -> void:
	if FileAccess.file_exists(SAVE_PATH):
		DirAccess.remove_absolute(SAVE_PATH)

## Saves current run state to disk (call at every node transition)
func save_run() -> void:
	if not run_active:
		return
		
	var party_data = []
	for hero in party:
		party_data.append({
			"data_path": hero["data"].resource_path,
			"current_hp": hero["current_hp"],
			"skills": hero["skills"].map(func(s): return s.resource_path),
			"slot_index": hero.get("slot_index", 0),
			"max_hp_override": hero.get("max_hp_override", hero["data"].base_hp),
			"atk_override": hero.get("atk_override", hero["data"].base_atk),
			"speed_override": hero.get("speed_override", hero["data"].base_speed),
			"pos_x": hero["position"].x,
			"pos_y": hero["position"].y
		})
		
	var inventory_data = inventory.map(func(i): return i.resource_path)
		
	var data = {
		"gold": gold,
		"difficulty": difficulty,
		"run_stats": run_stats,
		"current_map": current_map,
		"current_node_id": current_node_id,
		"completed_node_ids": completed_node_ids,
		"pending_reward_node_id": pending_reward_node_id,
		"pending_reward_options": pending_reward_options,
		"pending_reward_gold": pending_reward_gold,
		"encounter_gold_start": encounter_gold_start,
		"party": party_data,
		"inventory": inventory_data
	}
	var json_string = JSON.stringify(data, "\t")
	var file = FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[RunState] Could not open save file for writing")
		return
	file.store_string(json_string)
	file.close()
	print("[RunState] Run saved.")

## Loads the run state from disk
func load_run() -> bool:
	if not has_saved_run():
		return false
	var file = FileAccess.open(SAVE_PATH, FileAccess.READ)
	if file == null:
		return false
	var json_string = file.get_as_text()
	file.close()
	
	var data = JSON.parse_string(json_string)
	if data == null:
		push_error("[RunState] Save file is corrupted")
		return false
		
	gold = data.get("gold", 0)
	difficulty = data.get("difficulty", "normal")
	run_stats = data.get("run_stats", {})
	current_map = data.get("current_map", [])
	current_node_id = data.get("current_node_id", "")
	clear_pending_reward()
	pending_reward_node_id = data.get("pending_reward_node_id", "")
	for path in data.get("pending_reward_options", []):
		pending_reward_options.append(str(path))
	pending_reward_gold = int(data.get("pending_reward_gold", 0))
	encounter_gold_start = int(data.get("encounter_gold_start", run_stats.get("gold_earned", 0)))
	
	var loaded_completed_ids = data.get("completed_node_ids", [])
	completed_node_ids.clear()
	for id in loaded_completed_ids:
		completed_node_ids.append(id)
	
	party.clear()
	var loaded_party = data.get("party", [])
	for h_data in loaded_party:
		var hero_res = load(h_data.get("data_path", ""))
		if not hero_res: continue
		var skills = []
		for s_path in h_data.get("skills", []):
			var s_res = load(s_path)
			if s_res: skills.append(s_res)
			
		party.append({
			"data": hero_res,
			"current_hp": h_data.get("current_hp", hero_res.base_hp),
			"max_hp_override": h_data.get("max_hp_override", hero_res.base_hp),
			"atk_override": h_data.get("atk_override", hero_res.base_atk),
			"speed_override": h_data.get("speed_override", hero_res.base_speed),
			"skills": skills,
			"slot_index": h_data.get("slot_index", 0),
			"position": Vector2i(h_data.get("pos_x", 0), h_data.get("pos_y", 0)),
			"status_effects": []
		})
		
	inventory.clear()
	var loaded_inventory = data.get("inventory", [])
	for i_path in loaded_inventory:
		var i_res = load(i_path)
		if i_res: inventory.append(i_res)
		
	run_active = true
	print("[RunState] Run loaded.")
	return true

## Saves meta-progression data
func save_meta() -> void:
	var json_string = JSON.stringify(meta, "\t")
	var file = FileAccess.open(META_SAVE_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[RunState] Could not save meta progress")
		return
	file.store_string(json_string)
	file.close()

## Loads meta-progression data
func load_meta() -> void:
	if not FileAccess.file_exists(META_SAVE_PATH):
		print("[RunState] No meta save found — using defaults")
		return
	var file = FileAccess.open(META_SAVE_PATH, FileAccess.READ)
	if file == null:
		push_error("[RunState] Could not open meta save file")
		return
	var json_string = file.get_as_text()
	file.close()
	var parsed = JSON.parse_string(json_string)
	if parsed == null:
		push_error("[RunState] Meta save file is corrupted")
		return
	meta.merge(parsed, true)  # Merge loaded data, overwriting defaults
	
	# TEST CHEAT: Grant 99,999 coins for Talent Tree testing (Debug only)
	if debug_mode:
		meta["darkworld_coins"] = 99999
		print("[RunState] Meta progress loaded. (DEBUG CHEAT ACTIVE: 99,999 Coins)")
	else:
		print("[RunState] Meta progress loaded.")
