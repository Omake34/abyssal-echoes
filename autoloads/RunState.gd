# PURPOSE: RunState — Holds ALL data about the current run in progress.
# When a new run starts, this is reset. When a run ends, results feed into meta-progression.
# This is the "save file" for the current run.
# HOW TO USE:
#   RunState.gold += 50          # Give player gold
#   RunState.party[0]            # Get first hero in party
#   RunState.start_new_run()     # Reset everything for a new run

extends Node

# ── CONSTANTS ─────────────────────────────────────────────────────────────────

const MAX_PARTY_SIZE      = 4
const MAX_INVENTORY_SLOTS = 12
const MAX_SKILLS_PER_HERO = 3
const SAVE_PATH           = "user://run_state.json"

# ── RUN STATE VARIABLES ───────────────────────────────────────────────────────

## The player's current party — array of HeroInstance dictionaries
## Each hero instance: { "data": HeroData, "current_hp": int, "skills": Array, "position": Vector2i }
var party: Array = []

## Player's current gold for this run
var gold: int = 0

## Items currently in the inventory (array of ItemData resources)
var inventory: Array = []

## Current node on the run map (0 = start)
var current_map_node: int = 0

## Which map nodes have been completed
var completed_nodes: Array = []

## Current run difficulty: "normal", "hard", "hell"
var difficulty: String = "normal"

# ── MAP STATE ─────────────────────────────────────────────────────────────────
## The procedural data generated by MapGenerator
var current_map: Array = []

## The ID of the node the player is currently at
var current_node_id: String = ""

## IDs of all nodes the player has finished
var completed_node_ids: Array[String] = []

## Statistics for the end-of-run summary
var run_stats: Dictionary = {
	"battles_won": 0,
	"enemies_killed": 0,
	"skills_merged": 0,
	"gold_earned": 0,
	"turns_survived": 0,
}

## Whether a run is currently active
var run_active: bool = false

## Returns the dictionary data for the current map node
func get_current_node_data() -> Dictionary:
	for layer in current_map:
		for node in layer:
			if node["id"] == current_node_id:
				return node
	return {}

# ── META PROGRESSION (persists between runs) ──────────────────────────────────
# Loaded from a separate save file — not reset on new run

var meta: Dictionary = {
	"darkworld_coins": 0,        # Currency earned between runs
	"unlocked_heroes": ["warrior", "archer"],  # Start with 2 classes
	"unlocked_skills": [],       # EX skills unlocked after first crafting
	"talent_points_spent": {},   # Talent tree progress
	"total_runs": 0,
	"total_victories": 0,
}

const META_SAVE_PATH = "user://meta_progress.json"

# ── LIFECYCLE ─────────────────────────────────────────────────────────────────

func _ready() -> void:
	load_meta()

# ── RUN MANAGEMENT ────────────────────────────────────────────────────────────

## Call this to start a fresh run. Resets all run-specific data.
func start_new_run(chosen_difficulty: String = "normal") -> void:
	party              = []
	gold               = 100  # Starting gold
	inventory          = []
	current_map_node   = 0
	completed_nodes    = []
	current_map        = []  # Will be regenerated by MapView
	current_node_id    = ""
	completed_node_ids = []
	difficulty         = chosen_difficulty
	run_active         = true
	run_stats = {
		"battles_won": 0,
		"enemies_killed": 0,
		"skills_merged": 0,
		"gold_earned": 100,
		"turns_survived": 0,
	}
	print("[RunState] New run started. Difficulty: " + difficulty)

## Call this when the run ends (win or lose).
func end_run(victory: bool) -> void:
	run_active = false
	meta["total_runs"] += 1
	if victory:
		meta["total_victories"] += 1
		meta["darkworld_coins"] += _calculate_coin_reward()
	save_meta()
	EventBus.run_ended.emit(victory, run_stats)

## Returns the coin reward based on run performance
func _calculate_coin_reward() -> int:
	var base = 10
	var difficulty_bonus = {"normal": 1, "hard": 2, "hell": 3}
	return base * difficulty_bonus.get(difficulty, 1)

# ── PARTY MANAGEMENT ──────────────────────────────────────────────────────────

## Adds a hero to the party. Returns false if party is full.
func add_hero_to_party(hero_data: Resource) -> bool:
	if party.size() >= MAX_PARTY_SIZE:
		push_warning("[RunState] Party is full — cannot add hero")
		return false
	var hero_instance = {
		"data": hero_data,
		"current_hp": hero_data.base_hp,
		"skills": [],          # Array of SkillData resources
		"position": Vector2i(0, 0),  # Formation grid position (col, row)
		"status_effects": [],
	}
	party.append(hero_instance)
	return true

## Heals all heroes by a percentage of their max HP (used at Rest nodes)
func heal_party(percent: float) -> void:
	for hero in party:
		var heal_amount = int(hero["data"].base_hp * percent)
		hero["current_hp"] = min(hero["current_hp"] + heal_amount, hero["data"].base_hp)

# ── INVENTORY MANAGEMENT ──────────────────────────────────────────────────────

## Adds an item to inventory. Returns false if full.
func add_item(item: Resource) -> bool:
	if inventory.size() >= MAX_INVENTORY_SLOTS:
		push_warning("[RunState] Inventory full")
		return false
	inventory.append(item)
	EventBus.item_acquired.emit(item)
	return true

## Removes an item from inventory.
func remove_item(item: Resource) -> void:
	inventory.erase(item)
	EventBus.item_removed.emit(item)

## Salvages an item — removes it and gives 1 upgrade material (TODO: material system)
func salvage_item(item: Resource) -> void:
	remove_item(item)
	gold += 5  # Placeholder: salvage gives 5 gold for now
	EventBus.gold_changed.emit(gold)

# ── GOLD MANAGEMENT ───────────────────────────────────────────────────────────

func add_gold(amount: int) -> void:
	gold += amount
	run_stats["gold_earned"] += amount
	EventBus.gold_changed.emit(gold)

func spend_gold(amount: int) -> bool:
	if gold < amount:
		push_warning("[RunState] Not enough gold")
		return false
	gold -= amount
	EventBus.gold_changed.emit(gold)
	return true

# ── SAVE / LOAD ───────────────────────────────────────────────────────────────

## Saves current run state to disk (call at every node transition)
func save_run() -> void:
	if not run_active:
		return
	var data = {
		"gold": gold,
		"current_map_node": current_map_node,
		"completed_nodes": completed_nodes,
		"difficulty": difficulty,
		"run_stats": run_stats,
		# Note: party and inventory are saved by ID reference only
		"party_hero_ids": party.map(func(h): return h["data"].id),
	}
	var json_string = JSON.stringify(data, "\t")
	var file = FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[RunState] Could not open save file for writing")
		return
	file.store_string(json_string)
	file.close()
	print("[RunState] Run saved.")

## Saves meta-progression data
func save_meta() -> void:
	var json_string = JSON.stringify(meta, "\t")
	var file = FileAccess.open(META_SAVE_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[RunState] Could not save meta progress")
		return
	file.store_string(json_string)
	file.close()

## Loads meta-progression data
func load_meta() -> void:
	if not FileAccess.file_exists(META_SAVE_PATH):
		print("[RunState] No meta save found — using defaults")
		return
	var file = FileAccess.open(META_SAVE_PATH, FileAccess.READ)
	if file == null:
		push_error("[RunState] Could not open meta save file")
		return
	var json_string = file.get_as_text()
	file.close()
	var parsed = JSON.parse_string(json_string)
	if parsed == null:
		push_error("[RunState] Meta save file is corrupted")
		return
	meta.merge(parsed, true)  # Merge loaded data, overwriting defaults
	print("[RunState] Meta progress loaded.")
